# Copy this file to .env.local and set your own values before running the app.
# Never commit .env.local or real database credentials to GitHub.

NEXT_PUBLIC_APP_NAME=bike auction Hub

# Local MongoDB (recommended for development)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=bike_auction_Hub

# MongoDB Atlas: paste the connection string from Atlas → Connect → Drivers
# MONGODB_URI=<your Atlas connection string>
# MONGODB_DB_NAME=bike_auction_Hub

# Google Maps Geocoding (create at https://console.cloud.google.com/apis/credentials)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Hunter.io email verification (optional — https://hunter.io/api)
NEXT_PUBLIC_HUNTER_API_KEY=

# Seed script: set to false to keep old bike auction collections
SEED_CLEAR_RIDE_DATA=true

# Set true only if DNS resolution fails on your network
FORCE_DNS=false